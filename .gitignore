# ------------------------------------------------------------------
# Python / Django / virtual‑environment artifacts
# ------------------------------------------------------------------
# Byte‑compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg
*.whl

# Virtual environment directories
venv/
ENV/
env/
.venv/
env.bak/

# Django specific
*.log
local_settings.py
db.sqlite3
db.sqlite3‑journal

# Static / media files generated by Django (if you collect them locally)
staticfiles/
media/

# ------------------------------------------------------------------
# Node / front‑end tooling (if any)
# ------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output (e.g., from npm scripts, webpack, Vite, etc.)
dist/
public/
*.bundle.js
*.bundle.css

# ------------------------------------------------------------------
# VS Code / IDE settings
# ------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------------------------------
